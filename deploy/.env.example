# Jeton d'accès à l'API et à l'interface (16 caractères minimum). Générez-en un :
#   openssl rand -hex 24
CALLISTSEO_TOKEN=

# Facultatif : adresse et port publiés sur l'hôte (défaut : 127.0.0.1:8080).
# CALLISTSEO_BIND=127.0.0.1
# CALLISTSEO_PORT=8080

# Recommandé : identifiant du robot avec une page d'information/un contact réels, pour que les
# administrateurs des sites audités sachent qui vous êtes. Le nom avant « / » (CallistSEO) est ce
# que robots.txt cible. Vide = « CallistSEO/<version> ».
# CALLISTSEO_USER_AGENT=CallistSEO/0.1 (+https://votre-site.fr/bot)
